# Copy this file to .env and paste the PostgreSQL connection string from
# Supabase Dashboard → Connect. Percent-encode reserved characters in the password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Optional isolated Postgres database for destructive integration tests.
DATABASE_URL_TEST=

API_PORT=3001
API_HOST=127.0.0.1
CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
