# RENDER API SERVICE
# Replace DATABASE_URL with Supabase Dashboard → Connect (use a connection
# string suitable for a hosted server; percent-encode reserved password chars).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Replace with the exact public origin of the Vercel frontend, without a path.
# Add any custom frontend domains separated by commas.
CLIENT_ORIGINS=https://your-aster-site.vercel.app

# Render supplies PORT automatically. Do not set PORT or API_PORT here.
# The API binds to 0.0.0.0 by default.
